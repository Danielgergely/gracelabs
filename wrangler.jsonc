{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gracelabs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // max 5 form submissions per minute per IP (per Cloudflare location)
  "ratelimits": [{ "name": "CONTACT_LIMIT", "namespace_id": "1101", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true },
  "vars": {
    "MAIL_TO": "hello@gracelabs.dev",
    "MAIL_FROM": "Grace Labs website <form@mail.gracelabs.dev>"
  },
  "routes": [
    { "pattern": "gracelabs.dev", "custom_domain": true },
    { "pattern": "www.gracelabs.dev", "custom_domain": true }
  ]
  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   RESEND_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, WHATSAPP_NUMBER (international format, no +)
}
