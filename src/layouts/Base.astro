---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/caveat';
import '../styles/global.css';
import { SITE, LANGS, type Lang } from '../data/site';

interface Props { lang: Lang; title: string; description: string; path?: string; noindex?: boolean; jsonLd?: object }
const { lang, title, description, path = '', noindex = false, jsonLd } = Astro.props;
const ogLocale = { en: 'en_GB', de: 'de_CH', hu: 'hu_HU' }[lang];
const url = (l: string) => `${SITE.url}/${l}/${path}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <Fragment>
      <link rel="canonical" href={url(lang)} />
      {LANGS.map(l => <link rel="alternate" hreflang={l} href={url(l)} />)}
      <link rel="alternate" hreflang="x-default" href={url('en')} />
    </Fragment>}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={`${SITE.url}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="theme-color" content="#08080b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
